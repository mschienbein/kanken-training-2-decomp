  "findings_fixed": [
    {
      "id": "V17-F01",
      "severity": "blocker",
      "root": "The if-words parser guard erased empty SHT_GROUP header/signature declarations before allocation/copy closure.",
      "fix": "New GroupDeclaration records every raw declaration, optional flag word, signature, full member indices, original object and issues. Independent declaration counts and all raw SHF_GROUP ownership survive combination. V18 checks every original input before local U1, and direct matching also requires the census. Empty/malformed/unaccounted declarations refuse; every affected copy must have an allocated member and a complete own-unit removal proof.",
      "review_counterexamples": {
        "empty_declarations": 6,
        "nonempty_controls": 12,
        "kinds": [
          "kept-code",
          "unplaced-data",
          "zero-member"
        ],
        "orders": [
          "owner-first",
          "foreign-first"
        ],
        "sizes": [
          0,
          4,
          8
        ],
        "result": "All 18 refuse; missing words refuse before prepare_unit_u1 is called."
      },
      "regressions": [
        "CompleteGroupCensusTest.test_review_six_empty_group_declarations_refuse_before_any_local_u1",
        "CompleteGroupCensusTest.test_review_twelve_nonempty_group_controls_still_refuse"
      ]
    },
    {
      "id": "V17-F02",
      "severity": "blocker",
      "root": "The common unit predicate retroactively required linker_rewrites on authentic pre-reporting schema-1 receipts.",
      "fix": "Rewrite reporting is optional only under the explicit historical legacy path for default-v2 receipts from before inputs.linker_model reporting. Later historical and every modern receipt still require it. All positive complete-image/BLZ and selected modern U1 evidence remains mandatory.",
      "regressions": [
        "AcceptGateTest.test_pre_rewrite_legacy_receipts_keep_their_recorded_optional_fields",
