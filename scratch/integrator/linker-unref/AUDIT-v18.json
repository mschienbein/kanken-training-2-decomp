  "empty_absent_structure_sweep": [
    {
      "boundary": "SHT_GROUP body/header mismatch",
      "observed": "A zero-sized body still has sh_info/signature and potentially live SHF_GROUP members; absence is not no group.",
      "change": "All declarations recorded independently of if words; no flag/member words are explicit issues. Partial words become a structural LinkError before any U1 decision.",
      "coverage": "Six empty cases, twelve size-4/size-8 controls, and sizes 1/2/3/5/6/7 all exercised through actual synthetic ELF parsing and the bounded pipeline."
    },
    {
      "boundary": "Allocated/nonallocated member filtering",
      "observed": "section_groups historically filters membership to allocated indices, so valid raw nonallocated-only copies can vanish from per-section closure.",
      "change": "Raw member tuples are retained before filtering. V18 affected declarations must have at least one allocated member and all their allocated members must be in the corresponding local plan.",
      "coverage": "Same-signature nonallocated-only copy refuses in both orders; a fully accounted unrelated nonallocated group remains a positive control. Positive/zero-sized allocated foreign members remain vetoes."
    },
    {
      "boundary": "SHF_GROUP without a declaration / duplicate memberships",
      "observed": "A section can survive as ordinary allocated data if no declaration populates SectionMetadata.groups.",
      "change": "Full original ELF header membership map checks every SHF_GROUP section, every member flag and multiple owners, including nonallocated sections. Issues survive separately from allocated sections.",
      "coverage": "Orphan group flag, unknown flags, unrepresented index, zero-member and raw empty-group regression matrices."
    },
    {
      "boundary": "Combine/nested default-empty paths",
      "observed": "getattr(..., []) and missing count defaults could otherwise erase absent original census metadata.",
      "change": "Combination preserves declarations/origins/counts/issues and explicitly marks any missing original census attributes. Direct census requires all structures and exact count equality.",
      "coverage": "Each of three missing census fields refuses directly and after combination; empty declarations survive single and nested combination; dropped records with unchanged independent count refuse."
    },
    {
      "boundary": "Resolved/prepared views",
      "observed": "U1 preparation removes runtime sections but must not erase original group safety evidence.",
      "change": "Original declaration objects/counts/issues survive existing shallow resolved/prepared views and combination; builder preflights all originals before the first local U1 operation and later applies negative affected-copy proof. No aggregate positive authorization was added.",
      "coverage": "Inherited complete agreeing/contradictory copies, foreign-reference/personality matrices, zero-credit units, stage/action/witness tests and the real two-unit bounded build."
    },
    {
      "boundary": "Other empty dependency/retention structures",
      "observed": "Zero-sized allocated sections remain dependency_sections; LINK_ORDER/INFO_LINK and relocations are inventoried before placement. Noncanonical allocated relocation tables are checked before iterating their records. Empty ordinary directive bodies contain no directive payload, unlike a group header with a live signature; LLVM linker-option section type is retained regardless of body size.",
      "change": "No unrelated new ELF rule or weakened reference/retention rule. Existing zero-size/reference/metadata/retention tests all execute in the full linker module selection.",
      "qualification": "This is a targeted source/code-path sweep, not proof of all malformed ELF forms."
    },
    {
      "boundary": "Earlier model isolation",
      "observed": "Recording raw evidence must not silently repair v17 under its old selector.",
      "change": "Only v18 selects complete_group_declarations; v9-v17 keep their prior runtime decision gates. Unsupported partial-word parser exceptions are normalized to LinkError without making a formerly refused object eligible.",
      "coverage": "Dedicated v17 kept-code empty-group acceptance remains as an immutable-history control; earlier model tests and registry/default tests pass."
    }
  ],
